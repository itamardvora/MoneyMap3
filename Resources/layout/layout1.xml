<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הוספת השקעה"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:gravity="right" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הכנס את פרטי הקנייה של המניה"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:gravity="right" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="סימול מניה"
            android:textColor="#334155"
            android:textSize="14sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/dialogSymbolInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="לדוגמה: AAPL"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:padding="12dp"
            android:background="#F1F5F9"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="כמות מניות"
            android:textColor="#334155"
            android:textSize="14sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/dialogQuantityInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="לדוגמה: 2.5"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:padding="12dp"
            android:background="#F1F5F9"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מחיר קנייה למניה"
            android:textColor="#334155"
            android:textSize="14sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/dialogBuyPriceInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="לדוגמה: 180.50"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:padding="12dp"
            android:background="#F1F5F9"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="תאריך קנייה"
            android:textColor="#334155"
            android:textSize="14sp"
            android:gravity="right" />

        <EditText
            android:id="@+id/dialogBuyDateInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="yyyy-MM-dd"
            android:singleLine="true"
            android:focusable="false"
            android:clickable="true"
            android:padding="12dp"
            android:background="#F1F5F9"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מטבע הקנייה"
            android:textColor="#334155"
            android:textSize="14sp"
            android:gravity="right" />

        <Spinner
            android:id="@+id/dialogInvestmentCurrencySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="8dp"
            android:background="#F1F5F9"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/dialogSaveInvestmentButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="שמור השקעה"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB" />

    </LinearLayout>
</ScrollView>