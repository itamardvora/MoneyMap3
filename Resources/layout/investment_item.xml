<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:padding="14dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/pnlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="₪150"
            android:textColor="#16A34A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/pnlText"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/symbolText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AAPL"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buyDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-10-01"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

    </RelativeLayout>

    <!-- DETAILS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <!-- שורה 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qtyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="כמות: 10"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/buyPriceText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₪100"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:gravity="end" />
        </LinearLayout>

        <!-- שורה 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/costText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₪1,000"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/currentValueText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₪1,150"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- ACTION -->
    <TextView
        android:id="@+id/deleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="מחק"
        android:textColor="#DC2626"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>