<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="12dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp"
    android:elevation="3dp">

    <TextView
        android:id="@+id/symbolText"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="AAPL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/buyDateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2025-10-01" />

    <TextView
        android:id="@+id/qtyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="כמות: 10" />

    <TextView
        android:id="@+id/buyPriceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="מחיר קנייה: ₪ 100.00" />

    <TextView
        android:id="@+id/costText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="עלות: ₪ 1,000.00" />

    <TextView
        android:id="@+id/currentValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שווי נוכחי: ₪ 1,150.00" />

    <TextView
        android:id="@+id/pnlText"
        android:text="רווח/הפסד: ₪ 150.00"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/deleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="מחק"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:padding="6dp" />
</LinearLayout>
