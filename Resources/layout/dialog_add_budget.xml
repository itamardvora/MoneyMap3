<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הוספת תקציב"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="מלא את פרטי התקציב"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="חודש"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/budgetMonthInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:background="#F8FAFC"
            android:hint="yyyy-MM"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="סכום"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/budgetAmountInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:inputType="numberDecimal"
            android:background="#F8FAFC"
            android:hint="₪"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="קטגוריה"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/budgetCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="#F8FAFC"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <Button
            android:id="@+id/confirmAddBudgetButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="הוסף תקציב"
            android:textAllCaps="false"
            android:backgroundTint="#0F172A"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>