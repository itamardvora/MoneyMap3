<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addExpenseScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC"
    android:padding="10dp"
    android:clipToPadding="false">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="12dp"
        android:paddingBottom="80dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הוספת הוצאה"
            android:textColor="#0F172A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="מלא את פרטי ההוצאה והוסף קבלה אם צריך"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="תאריך הוצאה"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/expenseDateInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:background="#F8FAFC"
            android:gravity="center_vertical"
            android:hint="yyyy-mm-dd"
            android:focusable="false"
            android:clickable="true"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="סיבה"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/expenseReasonInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:background="#F8FAFC"
            android:gravity="center_vertical"
            android:hint="לדוגמה: קפה, סופר..."
            android:inputType="text"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="סכום"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/expenseAmountInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:background="#F8FAFC"
            android:gravity="center_vertical"
            android:hint="סכום"
            android:inputType="numberDecimal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="קטגוריה"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/expenseCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:background="#F8FAFC"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <Button
            android:id="@+id/captureReceiptButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#E2E8F0"
            android:text="צלם קבלה"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/receiptPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="#F8FAFC"
            android:contentDescription="תצוגת קבלה"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <Button
            android:id="@+id/confirmAddExpenseButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#0F172A"
            android:text="הוסף הוצאה"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>