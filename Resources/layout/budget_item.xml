<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <TextView
        android:id="@+id/categoryNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="קטגוריה: אוכל"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/plannedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="מתוכנן: 1,000 ₪"
        android:textColor="#334155"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/spentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="הוצאה: 600 ₪"
        android:textColor="#334155"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/remainingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="נותר: 400 ₪"
        android:textColor="#475569"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progress="60"
        android:progressTint="#2563EB"
        android:backgroundTint="#E2E8F0" />

    <Button
        android:id="@+id/btnViewExpenses"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#E2E8F0"
        android:text="צפה בהוצאות"
        android:textAllCaps="false"
        android:textColor="#0F172A"
        android:textStyle="bold" />
</LinearLayout>